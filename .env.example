# 서버의 ~/coldstorage/.env 에 실제 값을 넣는다. 이 파일은 예시일 뿐 값이 없다.
# 공개 저장소이므로 실제 비밀번호는 절대 커밋하지 않는다.

# 최초 관리자 계정 — users 테이블이 비어 있을 때만 사용된다.
# 계정이 이미 있으면 무시되므로, 비밀번호 변경은 화면에서 한다.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_NAME=관리자

# Cloudflare 터널(HTTPS) 뒤에서 운영할 때 1 로 두면 쿠키에 Secure 가 붙는다.
# 로컬 http 개발에서는 비워 둔다.
COOKIE_SECURE=1

# 선택 — 기본값 9000 / <repo>/data
# PORT=9000
# DATA_DIR=/data
